rules_version = '2';

// Security rules are the authority on access and shape (AD-8).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function inRange(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    // Tenths / halves with a tolerance, never float equality.
    function isTenths(v) {
      return math.abs(v * 10 - math.floor(v * 10 + 0.5)) < 0.000001;
    }

    function isHalves(v) {
      return math.abs(v * 2 - math.floor(v * 2 + 0.5)) < 0.000001;
    }

    function validWeight(v) {
      return inRange(v, 20, 400) && isTenths(v);
    }

    function validMood(v) {
      return inRange(v, 1, 10) && v == math.floor(v);
    }

    function validSleep(v) {
      return inRange(v, 0, 24) && isHalves(v);
    }

    function validEntry(id, d) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['weight', 'mood', 'sleep', 'updatedAt'])
        && d.keys().hasAll(['weight', 'updatedAt'])
        && d.updatedAt == request.time
        && validWeight(d.weight)
        && (!('mood' in d) || validMood(d.mood))
        && (!('sleep' in d) || validSleep(d.sleep));
    }

    function validPreferences(d) {
      return d.keys().hasOnly(['accent', 'language'])
        && d.keys().hasAll(['accent', 'language'])
        && d.accent in ['violet', 'teal', 'orange', 'magenta', 'blue', 'green']
        && d.language in ['it', 'en'];
    }

    match /users/{uid}/entries/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEntry(id, request.resource.data);
    }

    match /users/{uid}/preferences/app {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPreferences(request.resource.data);
    }
  }
}
