{
  "name": "weight4all",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "test": "ng test --watch=false && npm run test:lint",
    "emulators": "node scripts/emulators.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "check": "npm run lint && npm run test && npm run test:rules",
    "deploy": "npm run check && firebase deploy",
    "test:lint": "vitest run --config tests/lint/vitest.config.mts"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "chart.js": "4.5.1",
    "firebase": "12.19.0",
    "ng2-charts": "11.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
